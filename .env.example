# Supabase pooled PostgreSQL URL for application runtime.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true"

# Supabase direct PostgreSQL URL for Prisma migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Production origin used for canonical URLs, sitemap, robots, and social metadata.
NEXT_PUBLIC_SITE_URL="https://www.veloraautomations.com"

# Keep false until the final custom-domain launch is approved. Set true only for the indexable production deployment.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Server-only IndexNow ownership key. Add the same secret to Vercel Production and GitHub Actions.
INDEXNOW_API_KEY="your_indexnow_key_here"

# Enable only after an email provider, consent operations, and unsubscribe suppression are tested.
NEXT_PUBLIC_NEWSLETTER_ENABLED="false"

# Recommended for production operations: receives a JSON notification after a lead has been stored.
# Without it, leads remain in the database but no team notification is sent.
LEAD_NOTIFICATION_WEBHOOK_URL=""

# Public business contact details.
NEXT_PUBLIC_CONTACT_EMAIL="info@veloraautomations.com"
NEXT_PUBLIC_LINKEDIN_URL=""
