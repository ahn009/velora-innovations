# Supabase pooled PostgreSQL URL for application runtime.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres?pgbouncer=true&sslmode=require"

# Supabase direct PostgreSQL URL for Prisma migrations.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Production origin used for canonical URLs, sitemap, robots, and social metadata.
NEXT_PUBLIC_SITE_URL="https://www.veloraautomations.com"

# Production is indexable by default; set false only for an intentional temporary suppression. Vercel previews remain noindex.
NEXT_PUBLIC_ALLOW_INDEXING="true"

# Server-only IndexNow ownership key. Add the same secret to Vercel Production and GitHub Actions.
INDEXNOW_API_KEY="your_indexnow_key_here"

# Enable only after an email provider, consent operations, and unsubscribe suppression are tested.
NEXT_PUBLIC_NEWSLETTER_ENABLED="true"

# Server-side Velora Assistant. Keep both flags false until migration, ingestion, and QA are complete.
RAG_ENABLED="true"
NEXT_PUBLIC_RAG_CHAT_ENABLED="true"

# Server-only OpenAI credential and centrally configurable RAG models.
AI_API_KEY=""
RAG_CHAT_MODEL="gpt-5.6-sol"
RAG_REASONING_EFFORT="low"
RAG_RESPONSE_VERBOSITY="medium"
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_EMBEDDING_DIMENSIONS="1536"

# Retrieval, context, output, and timeout cost controls.
RAG_TOP_K="6"
RAG_SIMILARITY_THRESHOLD="0.35"
RAG_MAX_HISTORY_MESSAGES="8"
RAG_MAX_MESSAGE_LENGTH="2000"
RAG_MAX_OUTPUT_TOKENS="1200"
RAG_MAX_JSON_BYTES="24576"
RAG_PROVIDER_TIMEOUT_MS="25000"

# Optional OpenAI-compatible API base URL. The default is https://api.openai.com/v1.
OPENAI_BASE_URL="https://api.openai.com/v1"

# Development only. Debug data is still blocked whenever NODE_ENV=production.
RAG_DEBUG="false"

# Recommended for production operations: receives a JSON notification after a lead has been stored.
# Without it, leads remain in the database but no team notification is sent.
LEAD_NOTIFICATION_WEBHOOK_URL=""

# Public business contact details.
NEXT_PUBLIC_CONTACT_EMAIL="info@veloraautomations.com"
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_X_URL="https://x.com/Velora_Automate"
