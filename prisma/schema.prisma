generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  company        String
  industry       String
  budget         String?
  notes          String?
  source         String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?
  landingPage    String?
  primaryOpportunity   String?
  secondaryOpportunity String?
  readiness      String?
  timeline       String?
  consentVersion String
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([source])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("ACTIVE")
  source         String
  consentVersion String
  consentedAt    DateTime
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model KnowledgeChunk {
  id                  String   @id @default(cuid())
  sourceType          String
  sourceTitle         String
  sourceUrl           String?
  route               String?
  heading             String?
  content             String
  contentHash         String   @unique
  embedding           Unsupported("vector(1536)")?
  embeddingModel      String
  embeddingDimensions Int
  managedBy           String   @default("repository")
  ingestionRunId      String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sourceType])
  @@index([route])
  @@index([isActive])
  @@index([managedBy, ingestionRunId])
}

model KnowledgeIngestionRun {
  id                  String    @id @default(cuid())
  status              String
  embeddingModel      String
  embeddingDimensions Int
  pagesSeen           Int       @default(0)
  chunksSeen          Int       @default(0)
  chunksEmbedded      Int       @default(0)
  chunksReused        Int       @default(0)
  chunksDeactivated   Int       @default(0)
  errorCategory       String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([startedAt])
  @@index([status])
}
