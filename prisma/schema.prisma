generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Lead {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  company        String
  industry       String
  budget         String?
  notes          String?
  source         String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  utmTerm        String?
  referrer       String?
  landingPage    String?
  primaryOpportunity   String?
  secondaryOpportunity String?
  readiness      String?
  timeline       String?
  consentVersion String
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([source])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("ACTIVE")
  source         String
  consentVersion String
  consentedAt    DateTime
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
