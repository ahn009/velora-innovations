generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  phone          String?
  company        String
  industry       String
  budget         String?
  notes          String?
  source         String
  consentVersion String
  createdAt      DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model Subscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  status         String   @default("ACTIVE")
  source         String
  consentVersion String
  consentedAt    DateTime
  unsubscribedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RateLimitBucket {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}
